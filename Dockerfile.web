FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile
# These are Firebase's public browser settings, not server credentials.
ARG EXPO_PUBLIC_FIREBASE_API_KEY
ARG EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG EXPO_PUBLIC_FIREBASE_PROJECT_ID
ARG EXPO_PUBLIC_FIREBASE_APP_ID
RUN pnpm build:hosted
RUN pnpm --filter @workspace/api-server deploy --legacy --prod /opt/roundhouse-api
RUN mkdir -p /opt/roundhouse-api/dist && cp -a artifacts/api-server/dist/. /opt/roundhouse-api/dist/

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=3001 ROUNDHOUSE_WEB_DIR=/app/web
WORKDIR /app
COPY --from=build --chown=node:node /opt/roundhouse-api/ ./
COPY --from=build --chown=node:node /app/dist/web/ ./web/
USER node
EXPOSE 3001
CMD ["node", "--enable-source-maps", "dist/index.mjs"]
